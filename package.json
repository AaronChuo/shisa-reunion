{
  "name": "shisa-reunion",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:gen": "vitest run --project slow --project 'sweep-*'",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "e2e": "playwright test",
    "fonts": "node scripts/subset-font.mjs",
    "icons": "node scripts/make-icons.mjs",
    "photos": "node scripts/photos.mjs",
    "voice": "node --env-file-if-exists=.env.local scripts/voice.mjs",
    "bench:gen": "vitest run --config vitest.bench.config.ts scripts/bench-gen.ts",
    "bench:solver": "vitest run --config vitest.bench.config.ts scripts/bench-solver.ts",
    "bench:sweep": "vitest run --config vitest.bench.config.ts scripts/bench-sweep.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "immer": "^11.1.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-window": "^7.4.1"
  }
}
